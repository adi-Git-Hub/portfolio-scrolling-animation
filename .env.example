# Nodemailer Configuration for Portfolio Contact Form
# ===================================================
# To send live emails to Hrutuja's Gmail inbox:
# 1. Go to your Google Account (hrutujadhoble483@gmail.com)
# 2. Enable 2-Step Verification (Security tab)
# 3. Search for "App Passwords"
# 4. Create a new App Password named "Portfolio"
# 5. Copy the 16-character generated password and paste below
#
# NOTE: If left blank or commented out, Nodemailer will automatically
# run in TEST MODE using Ethereal Email and generate preview URLs!

# Email service (default: gmail)
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true

# Credentials
EMAIL_USER=hrutujadhoble483@gmail.com
EMAIL_PASS=your_16_character_app_password_here

# Recipient (where contact messages are delivered)
EMAIL_TO=hrutujadhoble483@gmail.com

# Backend Server Port (optional, default: 5001)
PORT=5001
